<?xml version="1.0" encoding="utf-8"?>
<!-- IIS only: MIME types this folder needs. Other hosts ignore this file. -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
</configuration>
